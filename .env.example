# Copy this file to .env (never commit .env) and fill in your own values.
OPENAI_API_KEY=

# Which index the chatbot searches: v1 (original) or v2 (new structure-aware chunks).
INDEX_VERSION=v1
# Tokens the chat model may read per question (Ollama cuts the prompt off beyond this).
OLLAMA_NUM_CTX=8192

# Search style for script and textbook: vector (meaning only) or hybrid (meaning + exact keywords).
RETRIEVAL_MODE=vector
HYBRID_ALPHA=0.75
# Re-score the top candidates with a cross-encoder and keep the best 5 (first use downloads an 80 MB model).
RERANK_ENABLED=false
RERANK_CANDIDATES=30
