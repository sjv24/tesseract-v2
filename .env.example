# Copy this file to .env (never commit .env) and fill in your own values.
OPENAI_API_KEY=

# Which index the chatbot searches: v1 (original) or v2 (new structure-aware chunks).
INDEX_VERSION=v2
# Tokens the chat model may read per question (Ollama cuts the prompt off beyond this).
OLLAMA_NUM_CTX=8192

# Search style for script and textbook: vector (meaning only) or hybrid (meaning + exact keywords).
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.75
# Re-score the top candidates with a cross-encoder and keep the best 5 (first use downloads an 80 MB model).
RERANK_ENABLED=true
RERANK_CANDIDATES=30
# Chunks handed to the model per source (fewer is faster on a CPU, but finds the evidence less often).
TOP_K=5
# Extra answering rules: copy names and numbers exactly as the excerpts word them. Measured in EVALS.md.
STRICT_PROMPT=false

# The language models (any model pulled into Ollama). The router also parses the comments questions.
CHAT_MODEL=qwen3:8b
ROUTER_MODEL=qwen3:8b

# Only needed when the backend runs somewhere other than your computer (Docker Compose sets these itself).
WEAVIATE_HOST=localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
